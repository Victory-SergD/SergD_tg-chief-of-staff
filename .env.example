# tg-chief-of-staff — пример .env
# Скопируй в `.env` и заполни своими значениями.

# ─── Telegram ───────────────────────────────────────────
# Получить на https://my.telegram.org/apps
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789
PHONE=+79991234567
SESSION_NAME=tg_access/myname_telethon

# ─── Gemini (для транскрипции голосовых) ────────────────
# Получить на https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (опционально) HTTP прокси если Gemini заблокирован
GEMINI_PROXY=http://user:pass@host:port
# Модель: gemini-flash-lite-latest (дёшево/быстро) или gemini-1.5-flash-latest
GEMINI_MODEL=gemini-flash-lite-latest

# ─── Telegram-бот для уведомлений (опционально) ─────────
# Создать через @BotFather → /newbot
TG_BOT_TOKEN=

# Telethon прокси (опционально, для обхода блокировки TG в стране)
# Формат: http://user:pass@host:port  или  socks5://user:pass@host:port
TG_PROXY=

# MTProto (альтернатива SOCKS5, если SOCKS5 недоступен):
# TG_PROXY=mtproxy://7uWIPQHiQF5oBnUYhtK76rlnb29nbGUuY29t@90.156.230.112:8443
# (формат: mtproxy://SECRET@HOST:PORT — но Telethon его не поддерживает напрямую,
# нужна обёртка через python-mtproxy. SOCKS5 проще.)
